# Client-side (Vite) build flags. Copy to `.env.development.local` (gitignored)
# to change them without typing env vars inline on every `npm run dev`.
#
# `.env.development.local`, NOT `.env.local`: Vite loads `.env.local` in build
# mode too, and it outranks everything else — a local VITE_DEMO_MODE=false would
# silently ride along into `npm run deploy` and ship a non-demo build. The
# `.development.` variant is ignored by `vite build` entirely.
#
# No secrets belong in this file — everything here is baked into the browser
# bundle. All credentials live server-side in the Worker (.dev.vars).

# Demo mode. DEFAULT IS ON when unset — a production build MUST set this to
# false. When on: vault auto-unlocks with a derivable passphrase, the first-run
# wizard is skipped, and a demo patient is seeded. See src/lib/demoMode.ts.
# (In a DEV build only, the "Try Demo" button can force demo mode per-tab
# regardless of this flag, so one dev server serves both entry modes.)
VITE_DEMO_MODE=false

# Debug tooling in the UI. Defaults to ON when unset; set 'false' to hide.
VITE_DEBUG_TOOLS=true
