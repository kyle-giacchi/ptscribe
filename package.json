{
  "name": "ptnotes",
  "version": "0.1.0",
  "description": "PTScribe — local-first clinical scribe for physical therapy: record sessions, transcribe with Whisper, and draft structured notes with Claude.",
  "license": "AGPL-3.0-only",
  "author": "Kyle Giacchi",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "dev:secrets": "wrangler secrets-store secret create 1a8981cc326a4ce68ad6aa5cdf7c995b --name KEY_ENC_MASTER --scopes workers --value local-dev-master-key-not-a-real-secret",
    "db:migrate": "wrangler d1 migrations apply ptscribe-auth",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck:app && npm run typecheck:worker",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "deploy": "vite build && wrangler deploy",
    "cf:tail": "wrangler tail",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint",
      "prettier --write"
    ],
    "*.{json,jsonc,css,md,yml,yaml,html}": "prettier --write"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.26",
    "@huggingface/transformers": "^4.2.0",
    "@react-pdf/renderer": "^4.5.1",
    "@ricky0123/vad-web": "^0.0.30",
    "@tanstack/react-virtual": "^3.14.9",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "better-auth": "^1.6.26",
    "clsx": "^2.1.1",
    "hash-wasm": "^4.12.0",
    "kysely": "^0.29.4",
    "kysely-d1": "^0.4.0",
    "lucide-react": "^1.30.0",
    "motion": "^13.0.0",
    "onnxruntime-web": "^1.27.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.7",
    "soundtouchjs": "^0.3.0",
    "tailwind-merge": "^3.6.0",
    "tiptap-markdown": "^0.9.0",
    "vite-plugin-static-copy": "^4.1.1",
    "wavesurfer.js": "^7.12.11",
    "webm-muxer": "^5.1.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
